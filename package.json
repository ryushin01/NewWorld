    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@types/jest": "30.0.0",
    "dayjs": "^1.11.23",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "html2canvas-pro": "^2.6.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lucide-react-native": "^1.74.0",
    "prettier": "^3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "react-test-renderer": "^19.3.1",
    "redaxios": "^0.5.1",
    "sonner-native": "^0.27.0",
    "supercluster": "^9.1.0",
    "tamagui": "^3.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/open-sans": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-native": "^10.7.1",
    "@storybook/react-native-web-vite": "10.6.7",
    "@tamagui/cli": "^3.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.2",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "sharp": "^0.35.5",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "admin": "vite -c apps/admin/vite.config.mts",
    "build:admin": "VITE_DEMO=1 vite build -c apps/admin/vite.config.mts",
    "lint": "expo lint && eslint apps/admin --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "typecheck:admin": "tsc -p apps/admin/tsconfig.json",
    "test": "jest",
    "credits": "UPDATE_CREDITS=1 jest src/entities/destination/model/credits.test.ts",
    "assets": "node scripts/generate-assets.mjs",
    "test:e2e": "zsh scripts/e2e-ios.sh",
    "test:e2e:server": "zsh e2e/server/run.sh",
    "test:web": "EXPO_WEB_BASE_URL= node scripts/build-web.mjs && playwright test -c e2e/web/playwright.config.ts",
    "test:admin": "vitest run -c apps/admin/vite.config.mts",
    "test:admin:e2e": "pnpm run build:admin && playwright test -c apps/admin/e2e/playwright.config.ts",
    "size:admin": "size-limit",
    "lhci:admin": "node apps/admin/scripts/lighthouse.mjs",
    "screenshots": "zsh scripts/screenshots.sh",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:db": "node --test supabase/tests/rls.test.mjs supabase/tests/seed.test.mjs",
    "db:seed:export": "node scripts/export-supabase-seed.mjs",
    "demo:master": "node scripts/generate-demo-master.mjs",
    "storybook": "storybook dev -c .storybook -p 6006",
    "build:storybook": "storybook build -c .storybook -o storybook-static --quiet",
    "test:storybook": "playwright test -c e2e/storybook/playwright.config.ts",
    "size:web": "cd scripts/size-limit-web && size-limit",
    "test:coverage": "jest --coverage",
    "test:admin:coverage": "vitest run -c apps/admin/vite.config.mts --coverage",
    "coverage:check": "node scripts/coverage-check.mjs",
    "check": "node scripts/check.mjs",
    "bench:place-search": "node scripts/bench-place-search.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^~/(.*)$": "<rootDir>/$1",
      "^@tamagui/style-grammar/token-categories$": "<rootDir>/node_modules/@tamagui/style-grammar/dist/cjs/tokenCategories.cjs",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|tamagui|@tamagui/.*|sonner-native|supercluster|kdbush|standard-navigation|@expo-google-fonts/.*))"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "watchman": false,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "cjs",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/",
      "supabase/tests/",
      "/e2e/web/",
      "/e2e/storybook/",
      "/apps/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "supabase/functions/**/*.ts",
      "!**/*.test.{ts,tsx}",
      "!**/*.stories.tsx",
      "!**/*.d.ts",
      "!src/shared/lib/query-test-utils.tsx",
      "!supabase/functions/*/index.ts",
      "!supabase/functions/_types/**"
    ],
    "coverageDirectory": "coverage/app",
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "cacheDirectory": "<rootDir>/node_modules/.cache/jest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.16.1",
  "size-limit": [
    {
      "name": "어드민 첫 화면 JS(데모, gzip)",
      "path": [
        "apps/admin/dist/assets/index-*.js",
        "apps/admin/dist/assets/types-*.js",
        "apps/admin/dist/assets/demo-backend-*.js"
      ],
      "limit": "175 kB",
      "gzip": true
    },
    {
      "name": "어드민 CSS(글꼴 선언 포함, gzip)",
      "path": "apps/admin/dist/assets/*.css",
      "limit": "70 kB",
      "gzip": true
    }
  ]
}
